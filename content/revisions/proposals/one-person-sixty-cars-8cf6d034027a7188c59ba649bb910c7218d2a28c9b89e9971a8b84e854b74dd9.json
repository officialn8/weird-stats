  "fragment": "<link rel=\"stylesheet\" href=\"/assets/transport.css\">\n<script type=\"module\" src=\"/assets/transport.js\"></script>\n<script type=\"module\" src=\"/assets/transport-neighborhood.js\"></script>\n<section class=\"transport-story\" id=\"one-person-sixty-cars\" aria-labelledby=\"trip-title\">\n  <div class=\"trip-opening\"><div class=\"trip-intro\">\n    <div class=\"trip-title\"><h2 id=\"trip-title\">One person.<br>An entire car.</h2>\n      <p class=\"trip-deck\">A seat for you. A machine around you. Now multiply that bargain by everyone trying to get somewhere.</p>\n      <p class=\"trip-format\"><strong>Deep Dive</strong> · Space, energy &amp; the cost of empty seats</p>\n      <nav class=\"trip-contents\" aria-label=\"Inside this Deep Dive\"><a href=\"#trip-space\">Space</a><a href=\"#trip-energy\">Energy</a><a href=\"#trip-resources\">Resources</a><a href=\"#trip-neighborhood\">A better way</a><a href=\"#trip-sources\">Sources</a></nav>\n    </div>\n    <figure class=\"trip-figure\"><div class=\"trip-count\"><span><strong data-trip-people>60</strong> people</span><strong data-trip-count>60 cars</strong></div>\n      <div class=\"trip-controls\" role=\"group\" aria-label=\"Explore occupancy and the bus in traffic\" hidden><button type=\"button\" data-trip-load=\"1\" aria-pressed=\"true\">Drive alone</button><button type=\"button\" data-trip-load=\"2\" aria-pressed=\"false\">2 per car</button><button type=\"button\" data-trip-load=\"4\" aria-pressed=\"false\">4 per car</button><button type=\"button\" data-trip-load=\"60\" aria-pressed=\"false\">One bus</button><button type=\"button\" data-trip-load=\"traffic\" aria-pressed=\"false\">Bus in traffic</button></div>\n      <svg class=\"trip-field\" viewBox=\"0 0 1000 430\" role=\"img\" aria-label=\"A divided road with 60 single-occupancy cars queued in six lanes. Pale dots show travelers. Illustrative traffic, not a measured road or flow simulation.\">\n        <defs><g id=\"trip-car-shape\">\n      